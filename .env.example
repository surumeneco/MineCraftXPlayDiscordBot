DISCORD_BOT_TOKEN=

# Phase 5 SSH is disabled by default. Enable using compose.ssh.yaml only after provisioning.
VPS_SSH_ENABLED=false
VPS_ADMIN_GUILD_ID=
VPS_ADMIN_CHANNEL_ID=
# Comma-separated IDs. Only members with one of these roles may execute commands.
VPS_ADMIN_ROLE_IDS=
VPS_SSH_HOST=
VPS_SSH_PORT=22
# Dedicated non-root Linux login; never root or the Minecraft service account.
VPS_SSH_USER=
# Paths on the Docker host; never put private key contents in .env or Git.
VPS_SSH_KEY_SOURCE=
VPS_SSH_KNOWN_HOSTS_SOURCE=
