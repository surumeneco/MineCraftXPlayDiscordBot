DISCORD_BOT_TOKEN=

# Both fields must be configured to enable the internal notice notification receiver.
# Set the channel ID to the participant-facing announcement channel.
NOTICE_CHANNEL_ID=
# Shared secret with WebApp NOTICE_NOTIFY_SECRET, at least 32 bytes; never commit the real value.
NOTICE_NOTIFY_SECRET=
NOTICE_HTTP_PORT=3101

# Both fields enable the internal anonymous request receiver; use the operators' request channel.
REQUEST_CHANNEL_ID=
# Share only with the WebApp backend; use a different secret from the notice receiver.
REQUEST_NOTIFY_SECRET=
REQUEST_HTTP_PORT=3102
